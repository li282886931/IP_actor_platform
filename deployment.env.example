# Generate deployment.env with: python3 deploy/bootstrap.py --generate-env
# Empty secrets are intentionally rejected by Compose.
WEB_BIND_IP=0.0.0.0
WEB_PORT=8080
MYSQL_DATA_SOURCE=mysql_data
REDIS_DATA_SOURCE=redis_data
REPORTS_DATA_SOURCE=reports_data
PYTHON_IMAGE=python:3.11-slim-bookworm
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmmirror.com
NGINX_IMAGE=nginx:1.28-alpine
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=ip_actor_platform
MYSQL_USER=ip_actor
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
INITIAL_ROOT_PASSWORD=
TOKEN_TTL_SECONDS=43200
REDIS_CACHE_TTL_SECONDS=3600
# Keep the existing local report download path backed by reports_data.
# 可选值：local-placeholder / minio / aliyun-oss
# aliyun-oss 会优先读取环境变量，缺失时回退到 /root/.ossutilconfig
OSS_PROVIDER=local-placeholder
# To use Aliyun OSS, set OSS_PROVIDER=aliyun-oss and fill the following values.
ALIYUN_OSS_CONFIG_PATH=/root/.ossutilconfig
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=
# Full Authorization header accepted by the fixed image service (keep secret).
IMAGE_GENERATION_AUTHORIZATION=
# To use an external MinIO or S3-compatible endpoint, set OSS_PROVIDER=minio.
MINIO_ENDPOINT=
MINIO_BUCKET=ip-actor-platform
MINIO_SECURE=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Online generation uses SiliconFlow; use a model available to your account.
LLM_PROVIDER=siliconflow
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_MAX_TOKENS=8192
SILICONFLOW_THINKING_BUDGET=2048
SILICONFLOW_API_KEY=
# To use a local model, set LLM_PROVIDER=llama-server.
# Container localhost refers to the container, not the host.
# For a host LLM: http://host.docker.internal:8080/v1/chat/completions
LLAMA_SERVER_URL=
LLAMA_SERVER_MODEL=local-model
LLAMA_SERVER_TIMEOUT_SECONDS=300
LLAMA_SERVER_MAX_TOKENS=800
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
# Exact service origins, separated by commas, for configured live reads.
ANALYSIS_ALLOWED_ORIGINS=
# Connector credentials belong in CONNECTOR_ENV_FILE, never in browser settings
# or data_sources.credential_ref. The database stores reference names only.
CONNECTOR_ENV_FILE=./deployment.connectors.env.example
