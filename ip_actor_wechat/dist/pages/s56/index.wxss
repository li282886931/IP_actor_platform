.page {
  min-height: 100vh;
  padding: 32rpx;
  background: radial-gradient(900rpx 420rpx at 78% -8%, rgba(212, 175, 55, .09), rgba(16, 16, 18, 0) 62%), #101012;
}
.hero {
  padding: 40rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, .03), rgba(27, 27, 30, .9));
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .35);
}
.eyebrow {
  color: #d4af37;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.title {
  margin-top: 16rpx;
  color: #f5f5f5;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.subtitle {
  margin-top: 16rpx;
  color: #a3a3ab;
  font-size: 28rpx;
  line-height: 1.55;
}
.highlight {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #d4af37;
  background: rgba(212, 175, 55, .12);
  border: 1rpx solid rgba(212, 175, 55, .3);
  font-size: 24rpx;
}
.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, .025), #1b1b1e 200rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, .35);
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.panel-title {
  color: #f5f5f5;
  font-size: 30rpx;
  font-weight: 700;
}
.state {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #a3a3ab;
  background: #26262b;
  font-size: 22rpx;
}
.state.success {
  color: #8fdcb4;
  background: rgba(92, 199, 147, .12);
}
.state.example {
  color: #e8bd83;
  background: rgba(226, 171, 87, .12);
}
.input {
  margin-top: 20rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .1);
  border-radius: 16rpx;
  background: #202024;
  color: #f5f5f5;
}
.item {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 24rpx 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .07);
  border-radius: 12rpx;
  transition: background-color .15s ease;
}
.item:active {
  background: rgba(255, 255, 255, .04);
}
.item-main {
  min-width: 0;
}
.item-title {
  color: #f5f5f5;
  font-size: 28rpx;
  font-weight: 600;
}
.item-desc {
  margin-top: 8rpx;
  color: #a3a3ab;
  font-size: 24rpx;
  line-height: 1.5;
}
.badge {
  flex: 0 0 auto;
  align-self: flex-start;
  max-width: 320rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #d4af37;
  background: rgba(212, 175, 55, .12);
  font-size: 22rpx;
}
.detail-chevron {
  flex: 0 0 auto;
  color: #8b8b93;
  font-size: 40rpx;
  line-height: 1;
}
.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(92, 199, 147, .3);
  border-radius: 16rpx;
  color: #8fdcb4;
  background: rgba(92, 199, 147, .12);
  font-size: 24rpx;
}
.primary {
  margin-top: 32rpx;
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  color: #1a1405;
  background: linear-gradient(145deg, #f0d678, #d4af37 55%, #b8932a);
  box-shadow: 0 10rpx 28rpx rgba(212, 175, 55, .22);
  font-size: 30rpx;
  font-weight: 700;
}
.primary:active {
  opacity: .92;
  transform: scale(.99);
}
.finance-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
  margin-top: 8rpx;
}
.finance-grid .input {
  margin-top: 6rpx;
}
.field-label {
  margin-top: 12rpx;
  color: #a3a3ab;
  font-size: 22rpx;
  font-weight: 600;
}
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}
.metric-card {
  min-width: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, rgba(255,255,255,.025), #1b1b1e 200rpx);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.35);
}
.metric-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #d4af37;
  font-variant-numeric: tabular-nums;
}
.metric-value-success { color: #5cc793; }
.metric-value-warning { color: #e2ab57; }
.metric-value-danger { color: #f0837f; }
.metric-label {
  margin-top: 8rpx;
  color: #a3a3ab;
  font-size: 24rpx;
}
.metric-hint {
  margin-top: 6rpx;
  color: #8b8b93;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-card-tap:active {
  border-color: rgba(212, 175, 55, .3);
  transform: scale(.97);
}
.ring-panel {
  display: flex;
  gap: 28rpx;
  align-items: center;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, rgba(255,255,255,.025), #1b1b1e 200rpx);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.35);
}
.ring-chart {
  position: relative;
  flex: 0 0 168rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background-image: conic-gradient(#d4af37 0deg, rgba(255,255,255,.08) 0deg);
}
.ring-inner {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1b1b1e;
  border-radius: 50%;
}
.ring-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #f5f5f5;
  font-variant-numeric: tabular-nums;
}
.ring-meta {
  flex: 1;
  min-width: 0;
}
.ring-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #f5f5f5;
}
.ring-caption {
  margin-top: 10rpx;
  color: #8b8b93;
  font-size: 22rpx;
  line-height: 1.6;
}
.bar-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 14rpx 0;
}
.bar-label {
  flex: 0 0 80rpx;
  color: #a3a3ab;
  font-size: 22rpx;
}
.bar-track {
  position: relative;
  flex: 1;
  height: 24rpx;
  background: #202024;
  border-radius: 999rpx;
}
.bar-zero {
  position: absolute;
  top: -6rpx;
  bottom: -6rpx;
  left: 50%;
  width: 2rpx;
  background: rgba(255,255,255,.22);
}
.bar-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  border-radius: 999rpx;
}
.bar-fill.positive {
  background: linear-gradient(90deg, #b8932a, #e7c65c);
}
.bar-fill.negative {
  background: linear-gradient(90deg, #c66865, #f0837f);
}
.bar-value {
  flex: 0 0 132rpx;
  color: #d4af37;
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.bar-value.negative {
  color: #f0837f;
}
.bar-note {
  margin-top: 12rpx;
  color: #6f6f78;
  font-size: 20rpx;
}
.home-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 64rpx;
  padding: 0 16rpx;
  margin: 24rpx 0 0 32rpx;
  color: #d4af37;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
  background: rgba(212, 175, 55, .12);
  border: 1rpx solid rgba(212, 175, 55, .3);
  border-radius: 32rpx;
}
.home-button:active {
  opacity: .85;
}
.task-selection {
  padding: 20rpx 0 4rpx;
  color: #a3a3ab;
  font-size: 24rpx;
}
.task-item {
  align-items: flex-start;
}
.task-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 38rpx;
  margin-top: 2rpx;
  color: #1a1405;
  font-size: 22rpx;
  font-weight: 700;
  border: 2rpx solid rgba(255, 255, 255, .1);
  border-radius: 6rpx;
}
.task-checkbox.selected {
  background: #d4af37;
  border-color: #d4af37;
}
.item-desc.expanded {
  overflow: visible;
  white-space: normal;
}
.task-details {
  padding: 16rpx;
  margin-top: 14rpx;
  color: #a3a3ab;
  font-size: 22rpx;
  line-height: 1.6;
  background: rgba(212, 175, 55, .12);
  border: 1rpx solid rgba(212, 175, 55, .3);
  border-radius: 6rpx;
}
.task-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 32rpx;
}
.task-actions .primary,
.task-actions .reject {
  width: 100%;
  min-width: 0;
  margin-top: 0;
}
.reject {
  height: 92rpx;
  border: 1rpx solid rgba(240, 131, 127, .32);
  border-radius: 999rpx;
  color: #f4a5a2;
  background: rgba(240, 131, 127, .12);
  font-size: 30rpx;
  font-weight: 700;
}
