# Generate deployment.env with: python3 deploy/bootstrap.py --generate-env
# Empty secrets are intentionally rejected by Compose.
WEB_BIND_IP=0.0.0.0
WEB_PORT=8080
PYTHON_IMAGE=python:3.11-slim-bookworm
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.28-alpine
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=ip_actor_platform
MYSQL_USER=ip_actor
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=ip-actor-storage
MINIO_ROOT_PASSWORD=
MINIO_BIND_IP=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ip-actor-platform
SECRET_KEY=
INITIAL_ROOT_PASSWORD=
TOKEN_TTL_SECONDS=43200
REDIS_CACHE_TTL_SECONDS=3600
# Keep the existing local report download path backed by reports_data.
OSS_PROVIDER=local-placeholder
# Container localhost refers to the container, not the host.
# For a host LLM: http://host.docker.internal:8080/v1/chat/completions
LLAMA_SERVER_URL=
LLAMA_SERVER_MODEL=local-model
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
# Exact service origins, separated by commas, for configured live reads.
ANALYSIS_ALLOWED_ORIGINS=
CONNECTOR_ENV_FILE=./deployment.connectors.env
