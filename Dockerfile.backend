ARG PYTHON_IMAGE=python:3.11-slim-bookworm
FROM ${PYTHON_IMAGE}
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    OCR_CPU_THREADS=2 \
    OCR_TEXT_SCORE=0.5 \
    OMP_NUM_THREADS=2

WORKDIR /app
COPY requirements.txt ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt \
    && python -c "from pathlib import Path; import rapidocr_onnxruntime as r; p=Path(r.__file__).parent/'models'; assert (p/'ch_PP-OCRv4_det_infer.onnx').is_file(); assert (p/'ch_PP-OCRv4_rec_infer.onnx').is_file()" \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p /app/storage/reports \
    && chown -R app:app /app/storage

COPY app ./app
COPY deploy/bootstrap.py ./deploy/bootstrap.py
USER app
EXPOSE 8000
CMD ["python", "-m", "deploy.bootstrap"]
