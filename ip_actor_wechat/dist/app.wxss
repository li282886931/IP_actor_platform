page {
  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 28rpx;
  color: #f5f5f5;
  background: #101012;
}
view, text, button, input, scroll-view {
  box-sizing: border-box;
}
input {
  color: #f5f5f5;
}
button::after {
  border: 0;
}
